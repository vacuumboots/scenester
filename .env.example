# Plex server URL (inside Docker, use host.docker.internal)
PLEX_URL=http://host.docker.internal:32400

# Option 1: Hardcode a Plex token (get one at https://plex.tv/claim)
# PLEX_TOKEN=your-plex-token-here

# Option 2: OAuth login (no token needed — use the in-app "Connect to Plex" button)
# Leave PLEX_TOKEN commented out and the app will guide you through OAuth.

# Persistent data dir for OAuth token + client ID (mount as Docker volume)
# CLIPARR_DATA_DIR=/data
