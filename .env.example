# Scenester configuration. Every setting is optional; the values marked default
# are what the image uses when the variable is absent.
#
# Pre-rename names still work: any SCENESTER_X falls back to CLIPARR_X if unset,
# so an existing deployment keeps its configuration.

# ── Plex ───────────────────────────────────────────────────────────────────

# Where Plex is. Inside Docker on Linux, host.docker.internal needs
# --add-host=host.docker.internal:host-gateway (see deploy.sh / README).
PLEX_URL=http://host.docker.internal:32400

# Option 1: hardcode a Plex token (get one at https://plex.tv/claim)
# PLEX_TOKEN=your-plex-token-here

# Option 2: leave PLEX_TOKEN unset and use the in-app "Connect to Plex" button.
# The approved token is written to SCENESTER_DATA_DIR, so mount that or you
# re-login after every container recreate.

# ── Access control ─────────────────────────────────────────────────────────

# Shared secret for the API. Unset means OFF, which is only appropriate when
# nothing but you can reach the container.
#
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
#
# The browser gets an HttpOnly cookie from the unlock screen; scripts send
#   X-Scenester-Token: <token>
# Rotating the value invalidates every cookie already issued.
# SCENESTER_ACCESS_TOKEN=

# ── Storage ────────────────────────────────────────────────────────────────

# Finished clips and .part temp files. Size it for the largest export: a
# 10 minute 1080p clip is roughly 150 MB.
# SCENESTER_CLIPS_DIR=/tmp/clips        (default)

# Derived-artefact cache (frames, thumbnails). Deterministic and safe to
# delete; it costs a re-extract, not data.
# SCENESTER_CACHE_DIR=/data/cache       (default)

# Plex OAuth token + client id.
# SCENESTER_DATA_DIR=/data              (default)

# Where the media is visible inside the container. Plex reports absolute paths
# from ITS filesystem; these two translate them to the mount.
# PLEX_MEDIA_SRC=/data/media            (default)
# PLEX_MEDIA_DST=/media                 (default)

# ── Performance ────────────────────────────────────────────────────────────
#
# The host is shared with Plex and everything else, and the next two are the
# levers that decide whether opening the film strip makes the whole box slow:
# 12 concurrent frame requests once took a 4-core host from load 2.1 to 8.6.
# Lower concurrency before blaming ffmpeg — every frame is a real seek, and on
# spinning disks that is physical.

# Concurrent ffmpeg frame extractions.
# SCENESTER_FRAME_CONCURRENCY=2          (default)
# Concurrent clip encodes (each is a decode + scale + encode pipeline).
# SCENESTER_CLIP_CONCURRENCY=2           (default)
# Abandon a single frame extraction after this many seconds.
# SCENESTER_FRAME_TIMEOUT=25             (default)
# Film-strip frame width in pixels (wider = slower, more disk cache).
# SCENESTER_FRAME_WIDTH=640              (default)
# Poster downscale width. Plex serves full-size posters.
# SCENESTER_THUMB_WIDTH=320              (default)

# ── Caching ────────────────────────────────────────────────────────────────
#
# In-process TTLs, seconds. Raise them if the library is huge and Plex is slow.
# SCENESTER_META_TTL=300                 (default)
# SCENESTER_LIBRARY_TTL=60               (default)
# Subtitle line index behind quote search, rebuilt on demand.
# SCENESTER_QUOTE_INDEX_TTL=21600        (default)
# Prune cached frames/thumbnails older than this, in days (0 = never).
# SCENESTER_CACHE_MAX_AGE_DAYS=14        (default)
# Prune finished clips older than this, in days (0 = keep).
# SCENESTER_CLIP_MAX_AGE_DAYS=0          (default)

# ── Encoding ───────────────────────────────────────────────────────────────

# Force the CPU (libx264) path even when a render node is present. Clips take
# roughly 10x longer; use it if hardware output ever looks wrong.
# SCENESTER_DISABLE_VAAPI=1

# Serve from somewhere other than the bundled frontend directory.
# SCENESTER_STATIC_DIR=/app/static
